  "rules": [
    {
      "path": "src/**/*.{vue,ts,tsx,js,jsx}",
      "rule": "\u4F60\u6B63\u5728\u5BA1\u67E5\u4F7F\u7528 Vue 3\u3001@xr/ui\u3001KendoUI \u548C @eplat/ei \u7684 XR \u524D\u7AEF\u9879\u76EE\u3002\u4F7F\u7528\u4E2D\u6587\u62A5\u544A\u6709\u4EE3\u7801\u4F9D\u636E\u7684\u95EE\u9898\uFF0C\u8BF4\u660E\u89E6\u53D1\u6761\u4EF6\u3001\u5F71\u54CD\u548C\u4FEE\u6539\u5EFA\u8BAE\uFF1B\u4E0D\u8981\u628A\u672A\u7ECF\u6838\u5B9E\u7684\u6846\u67B6\u884C\u4E3A\u5F53\u4F5C\u7F3A\u9677\u3002\n\n\u91CD\u70B9\u68C0\u67E5\uFF1A\n1. EiInfo \u5B57\u6BB5 ename \u662F\u5426\u7B26\u5408 block-row-field \u7EA6\u5B9A\uFF0CblockId \u662F\u5426\u4E0E\u5BF9\u5E94 EFGrid/EFRegion \u4E00\u81F4\u3002\n2. \u63A5\u53E3\u8C03\u7528\u662F\u5426\u590D\u7528\u9879\u76EE httpAction/queryDetail \u5165\u53E3\u3002\u7ED3\u5408\u8C03\u7528\u94FE\u5224\u65AD\u5F02\u5E38\u662F\u5426\u5DF2\u6709\u7EDF\u4E00\u5904\u7406\uFF1B\u91CD\u70B9\u68C0\u67E5\u5931\u8D25\u540E\u4ECD\u7EE7\u7EED\u6267\u884C\u6210\u529F\u8DEF\u5F84\u7684\u60C5\u51B5\u3002\n3. EFWindow \u5173\u95ED\u518D\u6253\u5F00\u65F6\uFF0C\u8868\u5355\u548C\u6821\u9A8C\u72B6\u6001\u662F\u5426\u6B8B\u7559\uFF1B\u4F9D\u8D56 DOM \u7684 fillNode/clearNode \u662F\u5426\u5728\u6E32\u67D3\u5B8C\u6210\u540E\u6267\u884C\u3002\n4. \u6279\u91CF\u64CD\u4F5C\u662F\u5426\u6821\u9A8C\u9009\u4E2D\u6570\u91CF\u53CA\u4E1A\u52A1\u5141\u8BB8\u7684\u72B6\u6001\uFF1B\u72B6\u6001\u542B\u4E49\u5FC5\u987B\u4F9D\u636E\u9879\u76EE\u5B9A\u4E49\uFF0C\u4E0D\u5F97\u731C\u6D4B\u3002\n5. \u5B57\u7B26\u4E32\u62FC\u63A5 onclick \u65F6\u662F\u5426\u6DF7\u5165\u672A\u7ECF\u8F6C\u4E49\u7684\u7528\u6237\u8F93\u5165\u3002\n\n\u6846\u67B6\u7EA6\u5B9A\uFF1A\n- EF \u548C xrForm \u662F\u6846\u67B6\u63D0\u4F9B\u7684\u5168\u5C40\u5BF9\u8C61\uFF0C\u4E0D\u8981\u4EC5\u56E0\u6CA1\u6709 import \u5C31\u62A5\u544A\u672A\u5B9A\u4E49\uFF1B\u4ECD\u9700\u68C0\u67E5\u8C03\u7528\u672C\u8EAB\u662F\u5426\u6B63\u786E\u3002\n- XR \u56FD\u9645\u5316\u6587\u672C\u901A\u5E38\u7531\u540E\u53F0\u914D\u7F6E\u5E76\u7531\u6846\u67B6\u52A0\u8F7D\uFF0C\u4E0D\u8981\u5C06\u4E2D\u6587\u6587\u672C\u4E00\u5F8B\u89C6\u4E3A\u7F3A\u9677\uFF0C\u4E5F\u4E0D\u8981\u65E0\u4F9D\u636E\u8981\u6C42\u6539\u6210 t()\u3002\n- \u5224\u65AD\u516C\u5171\u80FD\u529B\u662F\u5426\u88AB\u91CD\u590D\u5B9E\u73B0\u524D\uFF0C\u5148\u67E5\u9605\u9879\u76EE\u5DF2\u6709\u5C01\u88C5\u548C\u8C03\u7528\u65B9\u5F0F\u3002"
    }
  ]
